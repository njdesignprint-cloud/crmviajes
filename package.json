{
  "name": "via-clara-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:cloudflare": "wrangler deploy --config dist/server/wrangler.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint app db worker --ignore-pattern worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply via-clara-crm-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply via-clara-crm-db --remote"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0"
  },
  "type": "module"
}
